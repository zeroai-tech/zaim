# syntax=docker/dockerfile:1
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV ZAIM_MCP_HOST=0.0.0.0
ENV ZAIM_MCP_PORT=3001
ENV ZAIM_MCP_PATH=/mcp

# Copy application manifests and binaries
COPY package.json ./
COPY bin/ ./bin/
COPY lib/mcp/ ./lib/mcp/

# Ensure binaries are executable
RUN chmod +x bin/zaim-mcp.mjs bin/zaim-mcp-server.mjs

# Run as non-root user for security
USER node

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/health || exit 1

ENTRYPOINT ["node", "bin/zaim-mcp-server.mjs"]
